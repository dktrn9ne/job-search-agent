{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "web",
  "functions": {
    "api/portal.js": { "includeFiles": "portal/**" },
    "api/research.js": {
      "includeFiles": "agent/checkchaser-research-import-2000.json"
    }
  },
  "headers": [
    { "source": "/private/(.*)", "headers": [
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self'; img-src 'self' data:; frame-src blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" }
    ] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
